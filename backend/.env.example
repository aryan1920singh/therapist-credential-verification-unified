# ---------------------------------------------------------------------------
# Example environment configuration for the Therapist Credential
# Verification Backend.
#
# Copy this file to `.env` and replace the placeholder values locally.
# NEVER commit a real `.env` file, real secrets, passwords, tokens, or keys.
# The `.env` file is excluded by `.gitignore`.
# ---------------------------------------------------------------------------

# Human-readable application name.
APP_NAME=Therapist Credential Verification API

# Runtime environment. Example placeholders: development | testing | production
APP_ENV=development

# Debug mode. Use true only for local development.
DEBUG=true

# Base prefix for version 1 of the API.
API_V1_PREFIX=/api/v1

# Database connection string used by SQLAlchemy and Alembic.
# Replace with the real PostgreSQL connection details in your local `.env`.
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>

# Optional live PostgreSQL test connection string.
# Only needed to run the integration test in tests/test_database_postgres.py.
# Leave unset to skip that test. Do not commit a real value.
TEST_DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>

# Private local directory for uploaded credential documents.
# Keep this outside public static directories. The default is excluded by
# `.gitignore`; never commit uploaded documents.
DOCUMENT_STORAGE_DIR=storage/private_documents

# Maximum accepted upload size in bytes. Default is 10 MiB.
DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760

# Comma-separated declared content types. Module 6 only accepts PDF files.
DOCUMENT_ALLOWED_CONTENT_TYPES=application/pdf

# Private local directory for derived extracted-text artifacts.
# Never commit extracted document text.
EXTRACTED_TEXT_STORAGE_DIR=storage/private_extracted_text

# PDF extraction safety limits.
PDF_EXTRACTION_MAX_PAGES=30
PDF_EXTRACTION_MAX_TEXT_BYTES=2097152
PDF_EXTRACTION_RENDER_DPI=200
PDF_EXTRACTION_CHUNK_SIZE_CHARS=2000
PDF_EXTRACTION_CHUNK_OVERLAP_CHARS=200
PDF_EXTRACTION_OCR_MIN_CHARS=50
PDF_EXTRACTION_OCR_PAGE_TIMEOUT_SECONDS=30
PDF_EXTRACTION_OCR_TOTAL_TIMEOUT_SECONDS=300

# Tesseract OCR configuration.
# TESSERACT_CMD may be an executable name or an absolute path. Leave empty to
# use an installed Tesseract CLI, or the bundled tesserocr runtime.
TESSERACT_CMD=
TESSERACT_DATA_DIR=storage/tessdata
TESSERACT_LANGUAGE=eng

# Application secret key used for signing.
# Not used yet. PLACEHOLDER ONLY. Generate a strong random value locally and
# never commit it.
SECRET_KEY=replace-with-a-secure-random-value

# Access token lifetime in minutes.
# Not used yet. Authentication is planned for a later module.
ACCESS_TOKEN_EXPIRE_MINUTES=30
